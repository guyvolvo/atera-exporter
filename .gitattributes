# Authored on Windows, built and run on Linux. Without this, autocrlf can put CRLF
# into files that end up inside the container, where a stray \r breaks shell and
# YAML parsing in ways that are painful to diagnose.
* text=auto eol=lf

*.go      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
Dockerfile text eol=lf
go.sum    text eol=lf
