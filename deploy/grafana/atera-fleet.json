              "expr": "(\n  (time() - atera_agent_last_seen_timestamp_seconds >= $stale)\n  and on(agent_id) (atera_agent_online{folder=~\"$folder\"} == 0)\n) * on(agent_id) group_left(hostname, folder, os) atera_agent_info",
              "format": "table",
              "instant": true,
              "refId": "A"
